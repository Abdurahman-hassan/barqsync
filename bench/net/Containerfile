# Linux benchmark/verification image: real sshd on loopback shaped by tc netem, plus
# strace, perf and inferno for syscall counts and flamegraphs (original plan §8).
#
#   bench/net/container.sh build
#   bench/net/container.sh net        # tc network profiles: rsync vs fastrsync over ssh
#   bench/net/container.sh syscalls   # strace -c counts
#   bench/net/container.sh flamegraph # perf + inferno
FROM docker.io/library/rust:1-bookworm

RUN apt-get update -qq \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y -qq --no-install-recommends \
      rsync openssh-server openssh-client iproute2 strace linux-perf procps \
      python3 hyperfine time kmod \
 && rm -rf /var/lib/apt/lists/*

RUN cargo install --locked inferno \
 && rustup component add clippy

# Root logs in to its own sshd with a key; the "remote" end runs in this container.
RUN mkdir -p /run/sshd /root/.ssh \
 && ssh-keygen -q -t ed25519 -N '' -f /root/.ssh/id_ed25519 \
 && cat /root/.ssh/id_ed25519.pub > /root/.ssh/authorized_keys \
 && chmod 700 /root/.ssh && chmod 600 /root/.ssh/authorized_keys \
 && printf 'Host bench\n  HostName 127.0.0.1\n  StrictHostKeyChecking accept-new\n  UserKnownHostsFile /root/.ssh/known_hosts\n' > /root/.ssh/config

WORKDIR /work
